# Optional local configuration
VIXISU_DB_PATH=./vixisu.db
# Optional: absolute path to locally available YOLO model weights
# VIXISU_YOLO_WEIGHTS=/absolute/path/to/model.pt
# Optional: use an alternate Cricsheet evidence database
# VIXISU_CRICKET_EVIDENCE=/absolute/path/to/cricket_evidence.db
# Optional: require a workspace owner token for changes and private video output
# VIXISU_OWNER_TOKEN=replace-with-a-long-random-token
